APP_ENV=development
APP_SECRET_KEY=change-me-32-bytes-minimum-secret-key
APP_KEK=change-me-base64-32-byte-key-encryption-key
DATABASE_URL=postgresql+asyncpg://remote_assist:remote_assist_dev@127.0.0.1:5432/remote_assist
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000, *
EXTENSION_IDS=
DISPLAY_TIMEZONE=America/New_York
# PDF export converts the .docx with LibreOffice. Leave empty to find soffice on PATH.
SOFFICE_PATH=
# Generations run at once; the side panel tailors every open tab together.
WORKER_CONCURRENCY=3

# Public URLs, as the browser reaches them. The Upwork OAuth callback lands on
# the API and redirects back to the portal.
API_PUBLIC_URL=http://127.0.0.1:8000
PORTAL_URL=http://localhost:3000
# Which provider answers job searches. "apify" runs the Apify "Upwork Job
# Scraper" actor; "upwork" is Upwork's own GraphQL API (needs an Upwork key).
FREELANCING_JOB_SOURCE=apify
# Deployment-wide Apify token (https://console.apify.com/settings/integrations).
# Users can store their own under Settings -> Integrations instead.
APIFY_TOKEN=
# The actor: upwork-vibe~upwork-job-scraper (default) or neatrat~upwork-job-scraper.
APIFY_UPWORK_ACTOR_ID=upwork-vibe~upwork-job-scraper
# upwork-vibe add-ons, billed per job when on: proposal counts; client company and history.
APIFY_CLIENT_ACTIVITY_ADDON=false
APIFY_CLIENT_DETAILS_ADDON=false
APIFY_PAGES_PER_RUN=1
APIFY_WAIT_SECONDS=25
APIFY_RUN_TIMEOUT_SECONDS=300
# APIFY_MAX_CHARGE_USD=0.50
APIFY_REUSE_MINUTES=30
# Optional deployment-wide Upwork API key pair (https://www.upwork.com/developer/keys).
# Users can store their own pair in Settings -> Integrations instead.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
# Must match the redirect URI registered on the key. Derived from API_PUBLIC_URL when empty.
UPWORK_REDIRECT_URI=
