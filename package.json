{
  "name": "phoenix",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @phoenix/web",
    "dev:ext": "npm run dev -w @phoenix/extension",
    "build:web": "npm run build -w @phoenix/web",
    "build:ext": "npm run build -w @phoenix/extension",
    "types": "npm run generate -w @phoenix/api-types",
    "lint": "npm run lint --workspaces --if-present",
    "zip:ext": "npm run zip -w @phoenix/extension",
    "brand": "node scripts/brand-assets.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
