# Comma-separated hosts allowed to load Next.js dev assets cross-origin.
# Only needed when you browse the dev server from another machine.
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# Must be a URL the browser can reach. Avoid ports Chrome blocks
# (6000, 6665-6669, 6697 and friends) - it refuses them with ERR_UNSAFE_PORT.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
